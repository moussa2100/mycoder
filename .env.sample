# pgimcode environment configuration sample
# Copy this file to .env and fill in the values

# API provider (e.g., gemini, deepseek)
PGIMCODE_API_PROVIDER=gemini

# API keys
PGIMCODE_DEEPSEEK_API_KEY=your_deepseek_api_key_here
PGIMCODE_GEMINI_API_KEY=your_gemini_api_key_here

# Model settings
PGIMCODE_MODEL_NAME=gemini-3.5-flash
PGIMCODE_LLM_TEMPERATURE=0.2

# Per-agent model overrides (optional)
# PGIMCODE_READER_MODEL_NAME=
# PGIMCODE_EDITOR_MODEL_NAME=
# PGIMCODE_EXECUTOR_MODEL_NAME=
# PGIMCODE_PLANNER_MODEL_NAME=
# PGIMCODE_VERIFIER_MODEL_NAME=

# Advanced
# PGIMCODE_API_BASE_URL=
# PGIMCODE_LLM_MAX_TURNS=50
